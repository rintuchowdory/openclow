# Optional server-side credentials. Leave blank to use the Settings modal per session.
# NEVER prefix a provider secret with NEXT_PUBLIC_.
# Anyone using a configured public server can consume its provider quota.
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
OPENCLOW_OPENAI_API_KEY=

# Model defaults can be changed without editing source.
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
GEMINI_MODEL=gemini-3.5-flash-lite
OPENCLOW_OPENAI_MODEL=gpt-4o-mini

# Legacy Ollama route is disabled unless an owner explicitly configures a real service.
OLLAMA_API_URL=
OLLAMA_API_KEY=
